    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>aspnet-MedicalOffice-cda34fe1-3bec-45e5-90ec-479bb28a57a4</UserSecretsId>
